{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Primary storage account name"
      }
    },
    "destinationStorageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Destination storage account name for object replication"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "eastus2"
    },
    "destinationLocation": {
      "type": "string",
      "defaultValue": "centralus"
    },
    "skuName": {
      "type": "string",
      "defaultValue": "Standard_GRS"
    },
    "containerName": {
      "type": "string",
      "defaultValue": "images"
    },
    "fileShareName": {
      "type": "string",
      "defaultValue": "repairquotes"
    },
    "fileShareQuota": {
      "type": "int",
      "defaultValue": 100
    }
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "[parameters('skuName')]" },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot",
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[parameters('destinationStorageAccountName')]",
      "location": "[parameters('destinationLocation')]",
      "sku": { "name": "Standard_LRS" },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot",
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/default/{1}', parameters('storageAccountName'), parameters('containerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/default/{1}', parameters('destinationStorageAccountName'), parameters('containerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('destinationStorageAccountName'))]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/default/{1}', parameters('storageAccountName'), parameters('fileShareName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ],
      "properties": {
        "shareQuota": "[parameters('fileShareQuota')]",
        "enabledProtocols": "SMB"
      }
    }
  ],
  "outputs": {
    "primaryStorageAccount": {
      "type": "string",
      "value": "[parameters('storageAccountName')]"
    },
    "destinationStorageAccount": {
      "type": "string",
      "value": "[parameters('destinationStorageAccountName')]"
    }
  }
}
